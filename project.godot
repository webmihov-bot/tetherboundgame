[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="wrappable"

[physics]

3d/default_gravity=28.0

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.06, 1)

[shader_globals]

player_position={
"type": "vec3",
"value": Vector3(0, -1000, 0)
}
storm_intensity={
"type": "float",
"value": 0.2
}
